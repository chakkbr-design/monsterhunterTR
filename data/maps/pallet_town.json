   ],
   "sprite": "npc_girl.png",
   "wander": 3.0,
   "lines": [
    "The Pokémon in town are so calm. They never pick a fight!",
    "Route 1 is just north of here. The tall grass there is full of surprises."
   ],
   "y": 0.0
  },
  {
   "name": "Lab Aide",
   "node": "NPC_Scientist",
   "pos": [
    3.2,
    4.4
   ],
   "sprite": "npc_scientist.png",
   "lines": [
    "Ah, welcome! I study how Pokémon behave in the wild.",
    "Have you noticed? Some Pokémon run away from you, others charge right at you!",
    "Press 1 to 6 to let your partners out of their balls. They love walking with you."
   ],
   "y": 0.0
  },
  {
   "name": "Old Man",
   "node": "NPC_OldMan",
   "pos": [
    4,
    -16.5
   ],
   "sprite": "npc_oldman.png",
   "lines": [
    "Heading out to Route 1, are you?",
    "The longer you wander in tall grass, the more likely something jumps out at you.",
    "Stick to the path if you'd rather avoid trouble. Ho ho!"
   ],
   "y": 0.0
  }
